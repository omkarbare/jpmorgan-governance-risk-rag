from __future__ import annotations

import time
import uuid
from typing import Any

from fastapi import FastAPI, Header, HTTPException, Body
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, Field

from app.config import get_settings
from app.guardrails import (
    GuardrailDecision,
    safe_insufficient_evidence_answer,
    validate_input,
    validate_output,
)
from app.llm_client import chat_completion
from app.prompts import build_rag_messages
from app.retriever import retrieve_documents

settings = get_settings()

app = FastAPI(
    title=settings.app_name,
    version="0.5.0",
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=settings.cors_origins,
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


class AskRequest(BaseModel):
    query: str = Field(..., min_length=1, max_length=4000)
    top_k: int = Field(default=5, ge=1, le=10)


class Citation(BaseModel):
    citation_index: int
    score: float
    chunk_id: str
    doc_id: str
    doc_title: str
    doc_type: str
    section_path: str
    item_number: str
    page_pdf: int | None
    page_printed: int | None
    content_type: str
    table_caption: str | None
    source_file: str
    source_url: str | None = ""


class AskResponse(BaseModel):
    request_id: str
    answer: str
    citations: list[Citation]
    retrieval_count: int
    citation_count: int
    model: str
    collection: str
    latency_ms: int
    guardrail_status: str
    guardrail_reason: str | None = None


@app.get("/health")
async def health() -> dict[str, Any]:
    return {
        "status": "ok",
        "service": settings.app_name,
        "version": "0.5.0",
        "guardrails": "enabled",
    }


def _guardrail_response(
    *,
    request_id: str,
    message: str,
    reason: str,
    started_at: float,
) -> AskResponse:
    return AskResponse(
        request_id=request_id,
        answer=message,
        citations=[],
        retrieval_count=0,
        citation_count=0,
        model="none",
        collection=settings.qdrant_collection,
        latency_ms=int((time.perf_counter() - started_at) * 1000),
        guardrail_status="blocked",
        guardrail_reason=reason,
    )


def _build_citations(
    *,
    cited_indices: tuple[int, ...],
    chunks: list[dict[str, Any]],
) -> list[Citation]:
    index_to_chunk = {index: chunk for index, chunk in enumerate(chunks, start=1)}
    citations: list[Citation] = []

    for citation_index in cited_indices:
        chunk = index_to_chunk.get(citation_index)
        if not chunk:
            continue

        metadata = chunk.get("metadata", {})
        citations.append(
            Citation(
                citation_index=citation_index,
                score=float(chunk.get("score", 0.0)),
                chunk_id=str(metadata.get("chunk_id", "")),
                doc_id=str(metadata.get("doc_id", "")),
                doc_title=str(metadata.get("doc_title", "")),
                doc_type=str(metadata.get("doc_type", "")),
                section_path=str(metadata.get("section_path", "")),
                item_number=str(metadata.get("item_number", "")),
                page_pdf=metadata.get("page_pdf"),
                page_printed=metadata.get("page_printed"),
                content_type=str(metadata.get("content_type", "text")),
                table_caption=metadata.get("table_caption"),
                source_file=str(metadata.get("source_file", "")),
                source_url=metadata.get("source_url", ""),
            )
        )

    return citations


@app.post("/ask", response_model=AskResponse)
async def ask(
    request: AskRequest,
    # This value is request-scoped only. Never log, trace, persist, or return it.
    x_groq_api_key: str | None = Header(default=None),
) -> AskResponse:
    request_id = str(uuid.uuid4())
    started_at = time.perf_counter()

    input_decision: GuardrailDecision = validate_input(request.query)
    if not input_decision.allowed:
        return _guardrail_response(
            request_id=request_id,
            message=input_decision.user_message or "The request was blocked by a safety control.",
            reason=input_decision.reason or "input_guardrail",
            started_at=started_at,
        )

    safe_query = input_decision.sanitized_text or request.query

    try:
        chunks = retrieve_documents(safe_query, top_k=request.top_k)
    except Exception as error:
        # Keep internal details out of the public API response.
        raise HTTPException(
            status_code=503,
            detail="Document retrieval is temporarily unavailable. Please try again.",
        ) from error

    if not chunks:
        return AskResponse(
            request_id=request_id,
            answer=safe_insufficient_evidence_answer(),
            citations=[],
            retrieval_count=0,
            citation_count=0,
            model="none",
            collection=settings.qdrant_collection,
            latency_ms=int((time.perf_counter() - started_at) * 1000),
            guardrail_status="passed",
            guardrail_reason="insufficient_evidence",
        )

    messages = build_rag_messages(query=safe_query, chunks=chunks)

    try:
        answer = chat_completion(
            messages,
            temperature=0.1,
            max_tokens=700,
            groq_api_key=x_groq_api_key,
        )
    except Exception as error:
        # Keep provider exceptions, endpoint details, and keys off the response.
        raise HTTPException(
            status_code=503,
            detail="The language model is temporarily unavailable. Please try again.",
        ) from error

    output_decision = validate_output(
        answer=answer,
        max_citation_index=len(chunks),
        query=safe_query,
    )

    citations = _build_citations(
        cited_indices=output_decision.cited_indices,
        chunks=chunks,
    )

    return AskResponse(
        request_id=request_id,
        answer=output_decision.answer,
        citations=citations,
        retrieval_count=len(chunks),
        citation_count=len(citations),
        model="jpm-router",
        collection=settings.qdrant_collection,
        latency_ms=int((time.perf_counter() - started_at) * 1000),
        guardrail_status="blocked" if output_decision.blocked else "passed",
        guardrail_reason=output_decision.reason,
    )

@app.post("/retrieve")
async def retrieve_only(
    query: str = Body(..., embed=True),
    top_k: int = Body(5, ge=1, le=20),
    method: str = Body("hybrid", description="dense | sparse | hybrid"),
) -> dict[str, Any]:
    """
    Retrieval-only endpoint for evaluation.
    """
    chunks = retrieve_documents(query, top_k=top_k)

    return {
        "query": query,
        "method": method,
        "top_k": top_k,
        "results": [
            {
                "rank": idx + 1,
                "chunk_id": chunk["metadata"].get("chunk_id", ""),
                "doc_id": chunk["metadata"].get("doc_id", ""),
                "doc_type": chunk["metadata"].get("doc_type", ""),
                "score": float(chunk.get("score", 0.0)),
            }
            for idx, chunk in enumerate(chunks)
        ],
    }